{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ExternalProviders": {
    "TheSportsDb": {
      "BaseUrl": "https://www.thesportsdb.com/api/v1/json/",
      "RequestsPerMinute": 30
    },
    "Nominatim": {
      "BaseUrl": "https://nominatim.openstreetmap.org",
      "UserAgent": "Sporeo/1.0 (fixtures-api; contact@sporeo.app)",
      "MinRequestInterval": "00:00:01",
      "FoundCacheTtl": "90.00:00:00",
      "MissCacheTtl": "30.00:00:00"
    }
  },
  "ApiDocumentation": {
    "RequireAuthorization": false,
    "Title": "Sporeo Fixtures API",
    "Description": "Administrative and domain APIs for Sporeo fixture catalogs, venues, and related sports data.",
    "ContactName": "Sporeo Platform",
    "ContactEmail": "contact@sporeo.app",
    "LicenseName": "Proprietary",
    "Servers": [],
    "Security": {
      "SchemeName": "BearerAuth",
      "BearerFormat": "JWT",
      "Description": "JWT Bearer token issued by the Sporeo Identity service. Paste the access token without the 'Bearer ' prefix."
    }
  }
}
